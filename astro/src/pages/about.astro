---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About & Resume | ${SITE_TITLE}`}
			description="Software Engineer at Qualtrics. Backend systems, distributed infrastructure, and engineering resume."
		/>
		<style>
			.resume-header {
				padding: 1.5rem 0 2rem;
				border-bottom: 1px solid rgba(148, 163, 184, 0.16);
			}
			.resume-header-top {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				flex-wrap: wrap;
				gap: 1.25rem;
			}
			.eyebrow {
				margin: 0 0 0.4rem;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.resume-name {
				font-size: clamp(2.2rem, 4.5vw, 3.2rem);
				line-height: 1.1;
				margin: 0 0 0.35rem 0;
				color: rgb(var(--gray-dark));
			}
			.role-tag {
				font-size: 1.15rem;
				color: var(--accent);
				font-weight: 600;
				margin: 0;
			}
			.location-bullet {
				margin: 0 0.4rem;
				color: rgb(var(--gray));
			}
			.location-text {
				font-size: 0.95rem;
				color: rgb(var(--gray));
				font-weight: 400;
			}
			.resume-summary {
				margin: 1.25rem 0 1rem;
				font-size: 1.05rem;
				line-height: 1.65;
				color: rgb(var(--gray-dark));
				max-width: 720px;
			}
			.resume-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				align-items: center;
			}
			.contact-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				align-items: center;
				font-size: 0.95rem;
				margin-top: 0.75rem;
			}
			.contact-links a {
				color: var(--accent);
				text-decoration: none;
			}
			.contact-links a:hover {
				text-decoration: underline;
			}
			.contact-links .divider {
				color: rgb(var(--gray));
			}
			.section {
				margin-top: 2.75rem;
				padding-top: 0;
			}
			.section-heading {
				margin-bottom: 1.25rem;
				padding-bottom: 0.35rem;
				border-bottom: 1px solid rgba(124, 199, 255, 0.2);
				display: inline-block;
				font-size: 1.6rem;
			}
			.card {
				padding: 1.5rem 1.75rem;
				border: 1px solid var(--panel-border);
				border-radius: 16px;
				background: var(--panel);
				box-shadow: 0 10px 30px rgba(15, 18, 25, 0.18);
				margin-bottom: 1.5rem;
			}
			.exp-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 0.25rem;
			}
			.exp-title {
				font-size: 1.25rem;
				font-weight: 700;
				color: rgb(var(--gray-dark));
				margin: 0;
			}
			.exp-company {
				color: var(--accent);
				font-weight: 600;
				font-size: 1.02rem;
			}
			.exp-meta {
				font-size: 0.88rem;
				color: rgb(var(--gray));
			}
			.exp-desc {
				margin: 0.4rem 0 0.9rem;
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
				font-style: italic;
				line-height: 1.55;
			}
			.exp-list {
				margin: 0.5rem 0 0;
				padding-left: 1.25rem;
				line-height: 1.65;
			}
			.exp-list li {
				margin-bottom: 0.65rem;
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
			}
			.exp-list li:last-child {
				margin-bottom: 0;
			}
			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1.25rem;
			}
			.skill-category {
				background: rgba(15, 23, 42, 0.65);
				padding: 1.25rem;
				border-radius: 14px;
				border: 1px solid rgba(148, 163, 184, 0.12);
			}
			.skill-category h3 {
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--accent);
				margin: 0 0 0.5rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.skill-category p {
				margin: 0;
				font-size: 0.92rem;
				line-height: 1.55;
				color: rgb(var(--gray-dark));
			}
			.button-link {
				display: inline-flex;
				align-items: center;
				padding: 0.65rem 1.15rem;
				border-radius: 999px;
				background: linear-gradient(135deg, var(--accent), #9ad6ff);
				color: #06131f;
				text-decoration: none;
				font-weight: 700;
				font-size: 0.92rem;
				letter-spacing: 0.01em;
				transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
				box-shadow: 0 12px 24px rgba(124, 199, 255, 0.18);
			}
			.button-link:hover {
				transform: translateY(-1px);
				filter: brightness(1.04);
				box-shadow: 0 16px 28px rgba(124, 199, 255, 0.22);
			}
			.button-link.secondary {
				background: transparent;
				color: var(--accent);
				border: 1px solid rgba(124, 199, 255, 0.4);
				box-shadow: none;
			}
			.button-link.secondary:hover {
				background: rgba(124, 199, 255, 0.08);
			}
			@media (max-width: 720px) {
				.card {
					padding: 1.25rem;
				}
				.resume-header-top {
					flex-direction: column;
				}
			}
			@media print {
				:global(header),
				:global(footer),
				.resume-actions,
				.eyebrow {
					display: none !important;
				}
				:global(body) {
					background: #fff !important;
					color: #1a202c !important;
					font-size: 11pt !important;
					line-height: 1.45 !important;
				}
				:global(main) {
					width: 100% !important;
					max-width: 100% !important;
					padding: 0 !important;
					margin: 0 !important;
				}
				.resume-header {
					padding: 0 0 1rem !important;
					border-bottom: 2px solid #2d3748 !important;
				}
				.resume-name {
					color: #000 !important;
					font-size: 22pt !important;
				}
				.role-tag {
					color: #1e3a8a !important;
					font-size: 12pt !important;
				}
				.location-text {
					color: #4a5568 !important;
				}
				.resume-summary {
					color: #2d3748 !important;
					font-size: 10pt !important;
					margin: 0.4rem 0 !important;
				}
				.contact-links a {
					color: #1e3a8a !important;
				}
				.section {
					margin-top: 1.25rem !important;
					page-break-inside: auto;
				}
				.section-heading {
					font-size: 12pt !important;
					margin-bottom: 0.5rem !important;
					border-bottom: 1.5px solid #2d3748 !important;
					color: #000 !important;
					text-transform: uppercase;
					letter-spacing: 0.05em;
				}
				.card {
					background: transparent !important;
					border: none !important;
					box-shadow: none !important;
					padding: 0 0 0.5rem !important;
					margin-bottom: 0.75rem !important;
					break-inside: avoid;
					page-break-inside: avoid;
				}
				.exp-title {
					color: #000 !important;
					font-size: 11pt !important;
				}
				.exp-company {
					color: #1e3a8a !important;
					font-size: 10.5pt !important;
				}
				.exp-meta {
					color: #4a5568 !important;
					font-size: 9.5pt !important;
				}
				.exp-desc {
					color: #4a5568 !important;
					font-size: 9.5pt !important;
					margin: 0.25rem 0 0.4rem !important;
				}
				.exp-list li {
					color: #1a202c !important;
					font-size: 9.5pt !important;
					margin-bottom: 0.35rem !important;
				}
				.skills-grid {
					display: block !important;
				}
				.skill-category {
					background: transparent !important;
					border: none !important;
					padding: 0 0 0.35rem !important;
				}
				.skill-category h3 {
					color: #2d3748 !important;
					font-size: 9.5pt !important;
					margin-bottom: 0.1rem !important;
				}
				.skill-category p {
					color: #1a202c !important;
					font-size: 9.5pt !important;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="resume-header">
				<div class="resume-header-top">
					<div>
						<p class="eyebrow">Experience & Resume</p>
						<h1 class="resume-name">Charles Kwanin</h1>
						<p class="role-tag">
							Software Engineer @ Qualtrics
							<span class="location-bullet">&bull;</span>
							<span class="location-text">Provo, UT</span>
						</p>
					</div>
					<div class="resume-actions">
						<a class="button-link secondary" href="/resume.pdf" target="_blank" rel="noreferrer">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 0.4rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
							Download PDF
						</a>
					</div>
				</div>
				<p class="resume-summary">
					Backend and infrastructure engineer focused on distributed systems, high-availability APIs, and Kubernetes platforms
					serving mission-critical workloads across commercial and FedRAMP environments.
				</p>
				<div class="contact-links">
					<a href="https://www.linkedin.com/in/charles-kwanin/" target="_blank" rel="noreferrer">LinkedIn</a>
					<span class="divider">&bull;</span>
					<a href="https://github.com/charlesjkwanin" target="_blank" rel="noreferrer">GitHub</a>
				</div>
			</section>

			<section class="section">
				<h2 class="section-heading">Experience</h2>

				<article class="card">
					<div class="exp-header">
						<div>
							<h3 class="exp-title">Software Engineer</h3>
							<span class="exp-company">Survey Taking Platform, Qualtrics — Provo, UT</span>
						</div>
						<span class="exp-meta">June 2024 – Present</span>
					</div>
					<p class="exp-desc">
						Backend services for high-throughput survey response collection across commercial and FedRAMP environments.
					</p>
					<ul class="exp-list">
						<li>
							Designed and launched the public survey-sessions API, unlocking new integration channels and leading migrations across internal teams.
						</li>
						<li>
							Implemented enterprise bot defense and respondent verification (reCAPTCHA v3, honeypots, duplicate detection) to unblock key customer migrations.
						</li>
						<li>
							Led the container migration from Nomad to Kubernetes across commercial and FedRAMP/GovCloud datacenters, standardizing deployments with GitLab CI and Spinnaker.
						</li>
						<li>
							Built Go health probes for Kubernetes services, adopted company-wide across all Go services.
						</li>
						<li>
							Architected the public ingress layer to isolate service traffic, reduce NAT Gateway overhead, and enforce tiered rate limits.
						</li>
						<li>
							Contributed to org-wide north-star architecture and led team game days for incident response drills.
						</li>
						<li>
							Mentored engineers and interns across project scoping, system design, and production operations.
						</li>
					</ul>
				</article>

				<article class="card">
					<div class="exp-header">
						<div>
							<h3 class="exp-title">Software Engineer</h3>
							<span class="exp-company">Survey Quality Platform, Qualtrics — Provo, UT</span>
						</div>
						<span class="exp-meta">Sept 2022 – June 2024</span>
					</div>
					<p class="exp-desc">
						Platform covering survey versioning, approval workflows, quality scoring, and question libraries.
					</p>
					<ul class="exp-list">
						<li>
							Led the question-recommendation feature from design through launch, partnering on datastore selection and schema modeling.
						</li>
						<li>
							Built cross-service approval workflows and permissions to automate program launches upon survey publication.
						</li>
						<li>
							Shipped core API routes and UI components for the redesigned question library with comprehensive integration testing.
						</li>
						<li>
							Owned production services, clearing critical vulnerabilities through OWASP ZAP security audits.
						</li>
						<li>
							Expanded automated quality checks to flag question layout and accessibility issues prior to launch.
						</li>
					</ul>
				</article>

				<article class="card">
					<div class="exp-header">
						<div>
							<h3 class="exp-title">Technology Analyst</h3>
							<span class="exp-company">Goldman Sachs — Salt Lake City, UT</span>
						</div>
						<span class="exp-meta">July 2020 – Aug 2022</span>
					</div>
					<ul class="exp-list">
						<li>
							Modernized legacy event-processing pipelines to Java Spring Boot, Scala, Kafka, Elasticsearch, and MongoDB for increased throughput.
						</li>
						<li>
							Implemented fleet-wide observability, service health metrics, and alerting using Prometheus and Grafana.
						</li>
						<li>
							Mentored junior engineers and interns to reinforce code review and testing standards.
						</li>
					</ul>
				</article>
			</section>

			<section class="section">
				<h2 class="section-heading">Education</h2>
				<div class="card">
					<div class="exp-header">
						<div>
							<h3 class="exp-title">Oberlin College</h3>
							<span class="exp-company">B.A. in Computer Science — Oberlin, OH</span>
						</div>
						<span class="exp-meta">Sept 2016 – May 2020</span>
					</div>
				</div>
			</section>

			<section class="section">
				<h2 class="section-heading">Skills</h2>
				<div class="card">
					<div class="skills-grid">
						<div class="skill-category">
							<h3>Languages</h3>
							<p>Go, TypeScript, JavaScript, PHP, SQL, Java</p>
						</div>
						<div class="skill-category">
							<h3>Data & Messaging</h3>
							<p>MySQL, DynamoDB, MongoDB, Redis/Valkey, Kafka, SQS, Zod, Data Modeling & Schema Design</p>
						</div>
						<div class="skill-category">
							<h3>Cloud & Infrastructure</h3>
							<p>AWS (EC2, ELB, S3, SQS), Terraform, Kubernetes, Docker, Nomad, Spinnaker, Akamai, DNS</p>
						</div>
						<div class="skill-category">
							<h3>APIs & Testing</h3>
							<p>OpenAPI, Playwright, Cypress, OWASP ZAP, Twistlock, GitLab CI, Jenkins</p>
						</div>
						<div class="skill-category">
							<h3>Observability</h3>
							<p>Grafana, Prometheus, OpenTelemetry, Splunk</p>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
